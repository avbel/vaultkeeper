// Self-contained: the daemon hosts this component in a window-less process, so it shares no
// state with the window components. Slint 1.18's SystemTrayIcon has no template-image flag, so
// monochrome variants are switched by the menu bar appearance, which the daemon reads from AppKit
// and sets. `Palette.color-scheme` must not be used here: reading it makes Slint create a hidden
// window for the tray process (measured: an 800×600 window). While the appearance is unknown the
// neutral grey variant reads on both bars.
export component TrayIcon inherits SystemTrayIcon {
    in property <bool> locked: true;
    in property <bool> logged-in: true;
    in property <[string]> accounts;
    // The global Quick Panel shortcut as shown to the user, e.g. "⇧⌘Space"; empty hides the hint.
    in property <string> quick-hotkey;
    in property <string> generator-hotkey;
    in property <ColorScheme> menu-bar-scheme: ColorScheme.unknown;
    icon: root.menu-bar-scheme == ColorScheme.dark ? @image-url("icons/tray-light.svg")
        : root.menu-bar-scheme == ColorScheme.light ? @image-url("icons/tray-dark.svg")
        : @image-url("icons/tray-neutral.svg");
    tooltip: "bw-lite";

    callback quick-search();
    callback open-vault();
    callback generator();
    callback settings();
    callback lock-toggle();
    callback sync-now();
    callback switch-account(int);
    callback quit();

    Menu {
        MenuItem {
            title: root.quick-hotkey == "" ? "Quick search" : "Quick search    " + root.quick-hotkey;
            activated => { root.quick-search(); }
        }
        MenuItem {
            title: "Open vault";
            activated => { root.open-vault(); }
        }
        MenuItem {
            title: root.generator-hotkey == "" ? "Generator" : "Generator    " + root.generator-hotkey;
            activated => { root.generator(); }
        }
        MenuItem {
            title: "Settings…";
            activated => { root.settings(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.locked ? "Unlock" : "Lock";
            enabled: root.logged-in;
            activated => { root.lock-toggle(); }
        }
        MenuItem {
            title: "Sync now";
            enabled: !root.locked;
            activated => { root.sync-now(); }
        }
        Menu {
            title: "Accounts";
            for account[i] in root.accounts: MenuItem {
                title: account;
                activated => { root.switch-account(i); }
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

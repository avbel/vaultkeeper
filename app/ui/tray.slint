// Self-contained: the daemon hosts this component in a window-less process, so it shares no
// state with the window components. Slint 1.18's SystemTrayIcon has no template-image flag, so
// monochrome variants are switched by the menu bar appearance (it follows the wallpaper, not the
// system theme), which the daemon observes in AppKit and sets. `Palette.color-scheme` must not be used here: reading it makes Slint create a hidden
// window for the tray process (measured: an 800×600 window). While the appearance is unknown the
// neutral grey variant reads on both bars.
export component TrayIcon inherits SystemTrayIcon {
    in property <bool> locked: true;
    in property <bool> logged-in: true;
    in property <[string]> accounts;
    in property <bool> syncing;
    // "Last synced 12:04", or why the last "Sync now" failed; empty hides the line.
    in property <string> sync-label;
    in property <ColorScheme> menu-bar-scheme: ColorScheme.unknown;
    // The brand-blue glyph ignores the bar appearance (the Windows default).
    in property <bool> blue-icon: false;
    // Windows: the glyph rasterised at the notification area's pixel size; it replaces the SVG
    // choice below once the daemon has rendered one.
    in property <image> rendered-icon;
    in property <bool> use-rendered-icon: false;
    // The update item ("Check for Updates…", "Install Vaultkeeper 0.2.0 and Restart", …); empty
    // hides it in a daemon that does not update itself.
    in property <string> update-label;
    in property <bool> update-enabled: true;
    icon: root.use-rendered-icon ? root.rendered-icon
        : root.blue-icon ? @image-url("icons/tray-blue.svg")
        : root.menu-bar-scheme == ColorScheme.dark ? @image-url("icons/tray-light.svg")
        : root.menu-bar-scheme == ColorScheme.light ? @image-url("icons/tray-dark.svg")
        : @image-url("icons/tray-neutral.svg");
    tooltip: "Vaultkeeper";

    callback quick-search();
    callback open-vault();
    callback generator();
    callback settings();
    callback lock-toggle();
    callback sync-now();
    callback switch-account(int);
    callback update();
    callback quit();
    // Slint's Windows tray fires `clicked` on every left-button release and has no double-click
    // event, so the daemon pairs the clicks itself. AppKit never fires it while the menu is set.
    callback icon-clicked();
    clicked => { root.icon-clicked(); }

    Menu {
        // First, as the action a double-click on the icon runs.
        MenuItem {
            title: "Open vault";
            activated => { root.open-vault(); }
        }
        MenuItem {
            title: "Quick search";
            activated => { root.quick-search(); }
        }
        MenuItem {
            title: "Generator";
            activated => { root.generator(); }
        }
        MenuItem {
            title: "Settings…";
            activated => { root.settings(); }
        }
        Menu {
            title: "Accounts";
            for account[i] in root.accounts: MenuItem {
                title: account;
                activated => { root.switch-account(i); }
            }
        }
        MenuSeparator { }
        MenuItem {
            title: root.locked ? "Unlock" : "Lock";
            enabled: root.logged-in;
            activated => { root.lock-toggle(); }
        }
        MenuItem {
            title: root.syncing ? "Syncing…" : "Sync now";
            enabled: !root.locked && !root.syncing;
            activated => { root.sync-now(); }
        }
        if root.sync-label != "" && root.logged-in: MenuItem {
            title: root.sync-label;
            enabled: false;
        }
        MenuSeparator { }
        if root.update-label != "": MenuItem {
            title: root.update-label;
            enabled: root.update-enabled;
            activated => { root.update(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}

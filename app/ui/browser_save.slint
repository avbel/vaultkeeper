import { Theme } from "theme.slint";
import { Btn, BtnKind, PromptHeader, Select } from "kit.slint";

export component BrowserSavePrompt inherits Window {
    title: "Save login";
    icon: @image-url("icons/tray-dark.svg");
    no-frame: true;
    always-on-top: true;
    width: 380px;
    height: 240px;
    background: Theme.surface;
    default-font-size: Theme.font-body;

    in property <string> browser;
    in property <string> host;
    in property <string> username;
    in property <bool> update;
    // Offer to add `host` to the login `item-name` instead of saving or updating a password.
    in property <bool> address;
    in property <string> item-name;
    in property <[string]> choices;
    in-out property <int> choice-index: 0;
    in-out property <int> seconds-left: 30;
    callback save(int);
    callback dismiss();
    callback never();

    Timer {
        interval: 1s;
        running: root.seconds-left > 0;
        triggered => { root.seconds-left -= 1; }
    }
    Rectangle {
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-popup;
        clip: true;
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.dismiss(); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 18px;
                spacing: 8px;
                PromptHeader { glyph: @image-url("icons/shield.svg"); title: root.address ? "Add this address?" : root.update ? "Update password?" : "Save login?"; }
                Text { text: root.browser + " · " + root.host; color: Theme.text-muted; }
                if !root.address: Text { text: "Username from the page"; color: Theme.text-muted; font-size: Theme.font-meta; }
                if !root.address: Text { text: root.username; color: Theme.text; font-family: Theme.mono; overflow: elide; }
                if root.address: Text { text: "Add " + root.host + " to"; color: Theme.text-muted; font-size: Theme.font-meta; }
                if root.address: Text { text: root.item-name; color: Theme.text; overflow: elide; }
                if root.address: Text { text: "so it matches next time."; color: Theme.text-muted; font-size: Theme.font-meta; }
                if root.choices.length > 0: Select {
                    options: root.choices;
                    index <=> root.choice-index;
                    label: "Login to update";
                }
                Rectangle { vertical-stretch: 1; }
                Text { text: "Click to answer"; color: Theme.text-muted; font-size: Theme.font-meta; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    alignment: end;
                    if !root.address: Btn { text: "Never for this site"; label: "Never for this site"; clicked => { root.never(); } }
                    Btn { text: "Not now"; label: "Not now"; clicked => { root.dismiss(); } }
                    Btn { text: root.address ? "Add" : root.update ? "Update" : "Save"; label: root.address ? "Add" : root.update ? "Update" : "Save"; kind: BtnKind.primary; clicked => { root.save(root.choice-index); } }
                }
                Rectangle {
                    height: 3px;
                    border-radius: 1.5px;
                    background: Theme.surface-raised;
                    Rectangle { width: parent.width * max(0, root.seconds-left) / 30; height: 100%; border-radius: 1.5px; background: root.seconds-left < 6 ? Theme.warn : Theme.accent; animate width { duration: 1s; easing: linear; } }
                }
            }
        }
    }
}

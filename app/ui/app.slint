// Every exported component is a separate top-level window (or the tray icon) with its own
// instance of the globals below; Rust applies theme and generator state to each.
export { Theme, ThemeMode, Clock } from "theme.slint";
export { GeneratorState } from "generator.slint";
export { RowData } from "row.slint";
export { AssignChoice, DetailHeader, DetailField, AttachmentRow, EditField } from "detail.slint";
export { SidebarEntry } from "sidebar.slint";
export { AccountRow } from "accounts.slint";
export { ManagerWindow } from "manager.slint";
export { QuickPanel } from "quick.slint";
export { LockWindow, LoginWindow } from "auth.slint";
export { SettingsWindow, GeneratorWindow } from "settings.slint";
export { SshPrompt } from "ssh.slint";
export { TrayIcon } from "tray.slint";

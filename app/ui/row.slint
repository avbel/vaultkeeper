import { Theme, Clock } from "theme.slint";
import { Icon, CopyBtn, KindChip, TotpRing } from "kit.slint";

// Kinds: 0 login, 1 note, 2 card, 3 identity, 4 SSH key, 5 unsupported.
// Copy codes: 0 username, 1 password, 2 TOTP, 3 URI, 4 notes, 5 card number, 6 card code,
// 7 email, 8 phone, 9 SSH public key, 10 SSH private key, 99 the shown value, 100+n custom n.
export struct RowData {
    kind: int,
    name: string,
    subtitle: string,
    favorite: bool,
    reprompt: bool,
    b1: int,
    b2: int,
    b1-label: string,
    b2-label: string,
    has-totp: bool,
    totp-code: string,
    // `Clock.now` value at which `totp-code` expires.
    totp-expires: int,
    totp-period: int,
}

export component TotpCell inherits Rectangle {
    in property <string> code;
    in property <int> expires;
    in property <int> period;
    in property <bool> enabled: true;
    callback copy() -> bool;

    property <bool> copied: false;
    property <int> remaining: root.expires - Clock.now;
    width: 92px * Theme.scale;
    height: 24px * Theme.scale;
    border-radius: Theme.radius-control;
    background: copied ? Theme.success.with-alpha(0.14) : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 400ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: "Copy TOTP";
    accessible-value: root.code;
    accessible-action-default => { root.trigger(); }

    function trigger() {
        if root.enabled && root.copy() {
            root.copied = true;
        }
    }

    Timer {
        interval: 1.2s;
        running: root.copied;
        triggered => { root.copied = false; }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.trigger(); }
    }

    HorizontalLayout {
        padding-left: Theme.s1;
        padding-right: Theme.s1;
        spacing: Theme.s2;
        alignment: end;
        Text {
            text: root.code == "" ? "··· ···" : root.code;
            font-family: Theme.mono;
            font-size: Theme.font-body;
            font-weight: 500;
            letter-spacing: 1px;
            color: root.copied ? Theme.success-text : root.remaining < 5 ? Theme.warn-text : Theme.text;
            animate color { duration: 300ms; }
            vertical-alignment: center;
        }
        TotpRing {
            y: (parent.height - self.height) / 2;
            remaining: root.remaining;
            period: root.period;
        }
    }
}

export component ItemRow inherits Rectangle {
    in property <RowData> data;
    in property <bool> selected;
    // Draws the inner focus ring on the selected row while the list is driven by the keyboard.
    in property <bool> keyboard-focus;
    in property <bool> compact: false;
    callback clicked();
    callback double-clicked();
    callback copy(int) -> bool;

    height: compact ? Theme.row-height-compact : Theme.row-height;
    background: selected ? (ta.has-hover ? Theme.selection-hover : Theme.selection) : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    accessible-role: list-item;
    accessible-label: root.data.name;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    if root.selected: Rectangle {
        x: 0;
        width: 2px;
        background: Theme.accent;
    }
    if root.selected && root.keyboard-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.6);
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }

        HorizontalLayout {
            padding-left: Theme.s3;
            padding-right: Theme.s2;
            spacing: Theme.s3;
            KindChip {
                y: (parent.height - self.height) / 2;
                kind: root.data.kind;
                size: 22px * Theme.scale;
                opacity: ta.has-hover || root.selected ? 1 : 0.85;
                animate opacity { duration: 100ms; }
            }
            HorizontalLayout {
                horizontal-stretch: 3;
                preferred-width: 0px;
                min-width: 0px;
                spacing: Theme.s1;
                Text {
                    text: root.data.name;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.data.favorite: Text {
                    text: "★";
                    font-size: 10px * Theme.scale;
                    color: Theme.warn;
                    opacity: 0.8;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                horizontal-stretch: 2;
                preferred-width: 0px;
                min-width: 0px;
                text: root.data.subtitle;
                color: Theme.text-muted;
                font-size: Theme.font-hint;
                vertical-alignment: center;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 2px;
                alignment: end;
                width: 2 * Theme.control-height + 10px;
                if root.data.b1 >= 0: CopyBtn {
                    y: (parent.height - self.height) / 2;
                    code: root.data.b1;
                    label: root.data.b1-label;
                    emphasized: ta.has-hover || root.selected;
                    copy => { return root.copy(root.data.b1); }
                }
                if root.data.b2 >= 0: CopyBtn {
                    y: (parent.height - self.height) / 2;
                    code: root.data.b2;
                    label: root.data.b2-label;
                    emphasized: ta.has-hover || root.selected;
                    copy => { return root.copy(root.data.b2); }
                }
            }
            if root.data.has-totp: TotpCell {
                y: (parent.height - self.height) / 2;
                code: root.data.totp-code;
                expires: root.data.totp-expires;
                period: root.data.totp-period;
                copy => { return root.copy(2); }
            }
            if !root.data.has-totp: Rectangle {
                width: 92px * Theme.scale;
            }
        }
    }
}

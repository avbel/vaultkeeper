import { Theme } from "theme.slint";
import { Icon, CopyBtn, KindChip } from "kit.slint";

// Kinds: 0 login, 1 note, 2 card, 3 identity, 4 SSH key, 5 unsupported, 6 Send.
// Copy codes: 0 username, 1 password, 2 TOTP, 3 URI, 4 notes, 5 card number, 6 card code,
// 7 email, 8 phone, 9 SSH public key, 10 SSH private key, 11 Send link, 99 the shown value,
// 100+n custom n.
export struct RowData {
    kind: int,
    name: string,
    subtitle: string,
    favorite: bool,
    reprompt: bool,
    b1: int,
    b2: int,
    b1-label: string,
    b2-label: string,
    has-totp: bool,
    // A login with a password: the Quick Panel offers auto-type.
    auto-type: bool,
    // The site's icon once it has loaded; empty (width 0) until then and for other kinds.
    icon: image,
}

// Types username, Tab, password into the app behind the Quick Panel. The selected row shows the
// shortcut next to the glyph, unless shortcut hints are off.
component AutoTypeBtn inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> emphasized: false;
    in property <bool> hint-shown: false;
    callback clicked();

    // Same width on every row, so the copy buttons stay in one column.
    width: Theme.control-height + 30px * Theme.scale;
    height: 24px * Theme.scale;
    border-radius: Theme.radius-control;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: "Auto-type";
    accessible-description: "Types the username, Tab and the password into the app behind";
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: end;
        spacing: Theme.s1;
        padding-right: (Theme.control-height - 16px * Theme.scale) / 2;
        if root.enabled && root.hint-shown: Text {
            text: "⌘⇧↩";
            color: Theme.text-muted;
            font-size: Theme.font-meta;
            vertical-alignment: center;
        }
        if root.enabled: Icon {
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/keyboard.svg");
            tint: Theme.text;
            opacity: ta.has-hover || root.emphasized ? 1 : 0.55;
        }
    }
}

export component ItemRow inherits Rectangle {
    in property <RowData> data;
    in property <bool> selected;
    // Draws the inner focus ring on the selected row while the list is driven by the keyboard.
    in property <bool> keyboard-focus;
    in property <bool> compact: false;
    // The Quick Panel shows the Auto-type button on logins.
    in property <bool> offer-auto-type: false;
    callback clicked();
    callback double-clicked();
    callback copy(int) -> bool;
    callback auto-type();

    height: compact ? Theme.row-height-compact : Theme.row-height;
    background: selected ? (ta.has-hover ? Theme.selection-hover : Theme.selection) : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: 100ms; easing: ease-out; }
    accessible-role: list-item;
    accessible-label: root.data.name;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    if root.selected: Rectangle {
        x: 0;
        width: 2px;
        background: Theme.accent;
    }
    if root.selected && root.keyboard-focus: Rectangle {
        border-width: 2px;
        border-color: Theme.accent.with-alpha(0.6);
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }

        HorizontalLayout {
            padding-left: Theme.s3;
            padding-right: Theme.s2;
            spacing: Theme.s3;
            // One slot for the chip and the icon, so an icon arriving never moves the row.
            slot := Rectangle {
                y: (parent.height - self.height) / 2;
                width: 22px * Theme.scale;
                height: self.width;
                property <bool> icon-shown: Theme.site-icons && root.data.icon.width > 0;
                if !slot.icon-shown: KindChip {
                    kind: root.data.kind;
                    size: slot.width;
                    opacity: ta.has-hover || root.selected ? 1 : 0.85;
                    animate opacity { duration: 100ms; }
                }
                // No rounded clip: the software renderer ignores a clip's border radius.
                if slot.icon-shown: Image {
                    width: slot.width;
                    height: slot.height;
                    source: root.data.icon;
                    image-fit: contain;
                    accessible-role: none;
                }
            }
            HorizontalLayout {
                horizontal-stretch: 3;
                preferred-width: 0px;
                min-width: 0px;
                spacing: Theme.s1;
                Text {
                    text: root.data.name;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.data.favorite: Text {
                    text: "★";
                    font-size: 10px * Theme.scale;
                    color: Theme.warn;
                    opacity: 0.8;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                horizontal-stretch: 2;
                preferred-width: 0px;
                min-width: 0px;
                text: root.data.subtitle;
                color: Theme.text-muted;
                font-size: Theme.font-hint;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.offer-auto-type: AutoTypeBtn {
                y: (parent.height - self.height) / 2;
                enabled: root.data.auto-type;
                emphasized: ta.has-hover || root.selected;
                hint-shown: root.selected;
                clicked => { root.auto-type(); }
            }
            HorizontalLayout {
                spacing: 2px;
                alignment: end;
                width: 3 * Theme.control-height + 12px;
                if root.data.b1 >= 0: CopyBtn {
                    y: (parent.height - self.height) / 2;
                    code: root.data.b1;
                    label: root.data.b1-label;
                    emphasized: ta.has-hover || root.selected;
                    copy => { return root.copy(root.data.b1); }
                }
                if root.data.b2 >= 0: CopyBtn {
                    y: (parent.height - self.height) / 2;
                    code: root.data.b2;
                    label: root.data.b2-label;
                    emphasized: ta.has-hover || root.selected;
                    copy => { return root.copy(root.data.b2); }
                }
                // Codes show only in the detail pane; the list just copies them.
                if root.data.has-totp: CopyBtn {
                    y: (parent.height - self.height) / 2;
                    code: 2;
                    label: "Copy TOTP";
                    emphasized: ta.has-hover || root.selected;
                    copy => { return root.copy(2); }
                }
                // Keeps the other buttons in their column on rows without TOTP.
                if !root.data.has-totp: Rectangle {
                    width: Theme.control-height;
                }
            }
        }
    }
}

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Btn, BtnKind, CopyBtn, Divider, Segmented, SectionLabel, Select, ShortcutRecorder, Toggle } from "kit.slint";
import { GeneratorView } from "generator.slint";

component SettingRow inherits HorizontalLayout {
    in property <string> text;
    spacing: Theme.gap;
    min-height: 32px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    @children
}

export component SettingsWindow inherits Window {
    title: "bw-lite — settings";
    icon: @image-url("icons/tray-dark.svg");
    preferred-width: 520px;
    preferred-height: 640px;
    min-width: 440px;
    min-height: 420px;
    background: Theme.bg;
    default-font-size: Theme.font-body;

    in property <string> server;
    in-out property <int> theme-index;
    in-out property <int> scale-index;
    in property <[string]> lock-options;
    in-out property <int> lock-index;
    in property <[string]> clipboard-options;
    in-out property <int> clipboard-index;
    in-out property <bool> start-at-login;
    in-out property <bool> ask-unlock-on-start;
    in-out property <bool> lock-on-sleep: true;
    in-out property <bool> require-master-password;
    in property <bool> touch-id-available;
    in property <bool> touch-id-enrolled;
    in property <bool> unlocked;
    in-out property <bool> ssh-agent;
    in property <string> ssh-socket;
    // The ~/.ssh/config lines that point ssh at the agent.
    in property <string> ssh-config;
    in-out property <int> ssh-approval-index;
    in-out property <bool> ssh-touch-id;
    in-out property <bool> touch-id-right-away;
    // Saved accelerators ("Cmd+Shift+Space") and the same in symbols ("⇧⌘Space").
    in property <string> hotkey;
    in property <string> generator-hotkey;
    in property <string> hotkey-shown;
    in property <string> generator-hotkey-shown;
    // Which recorder waits for a key: 0 none, 1 Quick Panel, 2 Generator. Read by the winit key
    // filter, which records by physical key.
    out property <int> recording-slot: quick-recorder.recording ? 1 : generator-recorder.recording ? 2 : 0;
    in property <string> error-text;

    callback theme-selected(int);
    callback scale-selected(int);
    callback lock-selected(int);
    callback clipboard-selected(int);
    callback start-at-login-toggled(bool);
    callback ask-unlock-toggled(bool);
    callback lock-on-sleep-toggled(bool);
    callback require-master-password-toggled(bool);
    callback touch-id-enroll();
    callback touch-id-remove();
    callback ssh-agent-toggled(bool);
    callback copy-socket() -> bool;
    callback copy-ssh-config() -> bool;
    callback ssh-approval-selected(int);
    callback ssh-touch-id-toggled(bool);
    callback touch-id-right-away-toggled(bool);
    // Both save paths validate and save an accelerator; an empty one clears the Generator's.
    callback hotkey-accepted(string);
    callback generator-hotkey-accepted(string);
    // A key press in a recorder; `true` when it was saved.
    callback hotkey-pressed(string, bool, bool, bool, bool) -> bool;
    callback generator-hotkey-pressed(string, bool, bool, bool, bool) -> bool;

    // A recorder started (`true`) or stopped waiting for a key; the daemon pauses its hotkeys.
    callback recording-changed(bool);
    changed recording-slot => {
        root.recording-changed(self.recording-slot != 0);
    }

    public function stop-recording() {
        quick-recorder.stop();
        generator-recorder.stop();
    }

    VerticalLayout {
        // The window title, drawn in the transparent title bar beside the traffic lights.
        Rectangle {
            height: 28px;
            WindowMoveArea { }
            Text {
                text: "Settings";
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        ScrollView {
            VerticalLayout {
                padding: Theme.s5;
                padding-top: Theme.s3;
                spacing: Theme.s2;
                SectionLabel { text: "ACCOUNT"; }
                SettingRow {
                    text: "Server";
                    Text {
                        text: root.server;
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Server";
                        accessible-value: self.text;
                    }
                }
                Divider { }
                SectionLabel { text: "APPEARANCE"; }
                SettingRow {
                    text: "Theme";
                    Segmented {
                        width: 220px;
                        label: "Theme";
                        options: ["System", "Light", "Dark"];
                        index <=> root.theme-index;
                        selected(i) => { root.theme-selected(i); }
                    }
                }
                SettingRow {
                    text: "Text size";
                    Segmented {
                        width: 220px;
                        label: "Text size";
                        options: ["Default", "Large", "Larger"];
                        index <=> root.scale-index;
                        selected(i) => { root.scale-selected(i); }
                    }
                }
                Divider { }
                SectionLabel { text: "SECURITY"; }
                SettingRow {
                    text: "Lock after";
                    Select {
                        width: 200px;
                        label: "Lock after";
                        options: root.lock-options;
                        index <=> root.lock-index;
                        selected(i) => { root.lock-selected(i); }
                    }
                }
                Toggle { text: "Lock on sleep or screen lock"; checked <=> root.lock-on-sleep; toggled(v) => { root.lock-on-sleep-toggled(v); } }
                SettingRow {
                    text: "Clear clipboard";
                    Select {
                        width: 200px;
                        label: "Clear clipboard";
                        options: root.clipboard-options;
                        index <=> root.clipboard-index;
                        selected(i) => { root.clipboard-selected(i); }
                    }
                }
                Toggle { text: "Start at login"; checked <=> root.start-at-login; toggled(v) => { root.start-at-login-toggled(v); } }
                Toggle { text: "Ask to unlock on start"; checked <=> root.ask-unlock-on-start; toggled(v) => { root.ask-unlock-toggled(v); } }
                Toggle {
                    text: "Require master password on app start";
                    description: "Off: Touch ID alone unlocks after a restart";
                    checked <=> root.require-master-password;
                    toggled(v) => { root.require-master-password-toggled(v); }
                }
                SettingRow {
                    text: root.touch-id-enrolled ? "Touch ID is enrolled" : root.touch-id-available ? "Touch ID" : "Touch ID is not available";
                    if root.touch-id-available && !root.touch-id-enrolled: Btn {
                        text: "Enrol";
                        label: "Enrol Touch ID";
                        enabled: root.unlocked;
                        clicked => { root.touch-id-enroll(); }
                    }
                    if root.touch-id-enrolled: Btn {
                        text: "Remove";
                        label: "Remove Touch ID";
                        kind: BtnKind.danger;
                        clicked => { root.touch-id-remove(); }
                    }
                }
                Toggle {
                    text: "Unlock with Touch ID right away";
                    description: root.touch-id-enrolled ? "Skips the lock screen; it opens if Touch ID is cancelled" : "Enrol Touch ID to use this";
                    enabled: root.touch-id-enrolled;
                    checked <=> root.touch-id-right-away;
                    toggled(v) => { root.touch-id-right-away-toggled(v); }
                }
                Divider { }
                SectionLabel { text: "SSH AGENT"; }
                Toggle { text: "SSH agent"; checked <=> root.ssh-agent; toggled(v) => { root.ssh-agent-toggled(v); } }
                SettingRow {
                    text: "Socket";
                    Text {
                        text: root.ssh-socket;
                        font-family: Theme.mono;
                        font-size: Theme.font-meta;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 260px;
                    }
                    CopyBtn {
                        y: 4px;
                        code: 3;
                        label: "Copy socket path";
                        emphasized: true;
                        copy => { return root.copy-socket(); }
                    }
                }
                VerticalLayout {
                    spacing: Theme.s1;
                    Text {
                        text: "To use it, add to ~/.ssh/config:";
                        color: Theme.text-muted;
                        font-size: Theme.font-hint;
                    }
                    Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding: Theme.s2;
                            spacing: Theme.s2;
                            Text {
                                text: root.ssh-config;
                                font-family: Theme.mono;
                                font-size: Theme.font-meta;
                                color: Theme.text;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.text;
                                accessible-label: "SSH config lines";
                                accessible-value: self.text;
                            }
                            CopyBtn {
                                y: 0px;
                                code: 3;
                                label: "Copy SSH config lines";
                                emphasized: true;
                                copy => { return root.copy-ssh-config(); }
                            }
                        }
                    }
                }
                SettingRow {
                    text: "SSH requires approval";
                    Select {
                        width: 200px;
                        label: "SSH requires approval";
                        options: ["Always", "Remember until lock"];
                        index <=> root.ssh-approval-index;
                        selected(i) => { root.ssh-approval-selected(i); }
                    }
                }
                Toggle { text: "SSH requires Touch ID"; checked <=> root.ssh-touch-id; toggled(v) => { root.ssh-touch-id-toggled(v); } }
                Divider { }
                SectionLabel { text: "SHORTCUTS"; }
                SettingRow {
                    text: "Quick Panel hotkey";
                    quick-recorder := ShortcutRecorder {
                        width: 200px;
                        label: "Quick Panel hotkey";
                        shown: root.hotkey-shown;
                        pressed(text, control, meta, alt, shift) => {
                            return root.hotkey-pressed(text, control, meta, alt, shift);
                        }
                        entered(accelerator) => { root.hotkey-accepted(accelerator); }
                    }
                }
                SettingRow {
                    text: "Generator hotkey";
                    generator-recorder := ShortcutRecorder {
                        width: 200px;
                        label: "Generator hotkey";
                        shown: root.generator-hotkey-shown;
                        clearable: true;
                        pressed(text, control, meta, alt, shift) => {
                            return root.generator-hotkey-pressed(text, control, meta, alt, shift);
                        }
                        entered(accelerator) => { root.generator-hotkey-accepted(accelerator); }
                        cleared => { root.generator-hotkey-accepted(""); }
                    }
                }
                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.danger;
                    font-size: Theme.font-hint;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Settings error";
                    accessible-value: self.text;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

export component GeneratorWindow inherits Window {
    title: "bw-lite — generator";
    icon: @image-url("icons/tray-dark.svg");
    preferred-width: 420px;
    preferred-height: 28px + view.content-height;
    min-width: 360px;
    min-height: 240px;
    background: Theme.surface;
    default-font-size: Theme.font-body;
    VerticalLayout {
        // The title in the transparent title bar beside the traffic lights, as in Settings.
        Rectangle {
            height: 28px;
            WindowMoveArea { }
            Text {
                text: "Generator";
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        view := GeneratorView {
            show-title: false;
        }
    }
}

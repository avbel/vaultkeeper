import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Btn, BtnKind, CopyBtn, Divider, Segmented, SectionLabel, Select, ShortcutRecorder, Toggle } from "kit.slint";
import { GeneratorView, GeneratorState } from "generator.slint";

// `key` is the stored public key, which identifies the pairing to remove.
export struct PairedBrowserRow { name: string, fingerprint: string, key: string }

component SettingRow inherits HorizontalLayout {
    in property <string> text;
    spacing: Theme.gap;
    min-height: 32px;
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-body;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    @children
}

export component SettingsWindow inherits Window {
    title: "Vaultkeeper — settings";
    icon: @image-url("icons/tray-dark.svg");
    preferred-width: 520px;
    preferred-height: 640px;
    min-width: 440px;
    min-height: 420px;
    background: Theme.bg;
    default-font-size: Theme.font-body;

    in property <string> server;
    in-out property <int> theme-index;
    in-out property <int> tray-icon-index;
    in-out property <int> scale-index;
    in property <[string]> lock-options;
    in-out property <int> lock-index;
    in property <[string]> clipboard-options;
    in-out property <int> clipboard-index;
    in-out property <bool> start-at-login;
    in-out property <bool> auto-update;
    in-out property <bool> ask-unlock-on-start;
    in-out property <bool> lock-on-sleep: true;
    in-out property <bool> require-master-password;
    in property <bool> touch-id-available;
    in property <bool> touch-id-enrolled;
    in property <bool> unlocked;
    in-out property <bool> ssh-agent;
    in-out property <bool> cli-access;
    in property <string> cli-path-setup;
    in property <string> ssh-socket;
    // The ~/.ssh/config lines that point ssh at the agent.
    in property <string> ssh-config;
    in-out property <int> ssh-approval-index;
    in-out property <bool> ssh-touch-id;
    in-out property <bool> touch-id-right-away;
    in-out property <bool> show-site-icons: true;
    // Saved accelerators ("Cmd+Shift+Space") and the same in symbols ("⇧⌘Space").
    in property <string> hotkey;
    in property <string> generator-hotkey;
    in property <string> hotkey-shown;
    in property <string> generator-hotkey-shown;
    // Which recorder waits for a key: 0 none, 1 Quick Panel, 2 Generator. Read by the winit key
    // filter, which records by physical key.
    out property <int> recording-slot: quick-recorder.recording ? 1 : generator-recorder.recording ? 2 : 0;
    in-out property <bool> browser-integration;
    // The muted line under the master switch: "Off", "On" or why it cannot start.
    in property <string> browser-state;
    in property <bool> chrome-installed;
    in property <bool> firefox-installed;
    in-out property <bool> browser-chrome;
    in-out property <bool> browser-firefox;
    in-out property <bool> browser-touch-id;
    in-out property <bool> browser-save-prompts;
    in-out property <bool> browser-copy-totp;
    in-out property <bool> browser-fill-single;
    in-out property <bool> browser-passkeys;
    in-out property <int> browser-match-index;
    in property <[PairedBrowserRow]> paired-browsers;
    in property <string> error-text;

    callback theme-selected(int);
    callback tray-icon-selected(int);
    callback scale-selected(int);
    callback lock-selected(int);
    callback clipboard-selected(int);
    callback start-at-login-toggled(bool);
    callback auto-update-toggled(bool);
    callback ask-unlock-toggled(bool);
    callback lock-on-sleep-toggled(bool);
    callback require-master-password-toggled(bool);
    callback touch-id-enroll();
    callback touch-id-remove();
    callback ssh-agent-toggled(bool);
    callback cli-access-toggled(bool);
    callback copy-cli-path-setup() -> bool;
    callback copy-socket() -> bool;
    callback copy-ssh-config() -> bool;
    callback ssh-approval-selected(int);
    callback ssh-touch-id-toggled(bool);
    callback touch-id-right-away-toggled(bool);
    callback site-icons-toggled(bool);
    callback browser-integration-toggled(bool);
    callback browser-chrome-toggled(bool);
    callback browser-firefox-toggled(bool);
    callback browser-touch-id-toggled(bool);
    callback browser-save-prompts-toggled(bool);
    callback browser-copy-totp-toggled(bool);
    callback browser-fill-single-toggled(bool);
    callback browser-passkeys-toggled(bool);
    callback browser-match-selected(int);
    callback paired-browser-removed(string);
    // Both save paths validate and save an accelerator; an empty one clears the Generator's.
    callback hotkey-accepted(string);
    callback generator-hotkey-accepted(string);
    // A key press in a recorder; `true` when it was saved.
    callback hotkey-pressed(string, bool, bool, bool, bool) -> bool;
    callback generator-hotkey-pressed(string, bool, bool, bool, bool) -> bool;

    // A recorder started (`true`) or stopped waiting for a key; the daemon pauses its hotkeys.
    callback recording-changed(bool);
    changed recording-slot => {
        root.recording-changed(self.recording-slot != 0);
    }

    public function stop-recording() {
        quick-recorder.stop();
        generator-recorder.stop();
    }

    VerticalLayout {
        // The window title, drawn in the transparent title bar beside the traffic lights.
        Rectangle {
            height: 28px;
            WindowMoveArea { }
            Text {
                text: "Settings";
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        ScrollView {
            VerticalLayout {
                padding: Theme.s5;
                padding-top: Theme.s3;
                spacing: Theme.s2;
                SectionLabel { text: "ACCOUNT"; }
                SettingRow {
                    text: "Server";
                    Text {
                        text: root.server;
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Server";
                        accessible-value: self.text;
                    }
                }
                Divider { }
                SectionLabel { text: "APPEARANCE"; }
                SettingRow {
                    text: "Theme";
                    Segmented {
                        width: 220px;
                        label: "Theme";
                        options: ["System", "Light", "Dark"];
                        index <=> root.theme-index;
                        selected(i) => { root.theme-selected(i); }
                    }
                }
                SettingRow {
                    text: "Menu bar icon";
                    Segmented {
                        width: 220px;
                        label: "Menu bar icon";
                        options: ["Auto", "White", "Black"];
                        index <=> root.tray-icon-index;
                        selected(i) => { root.tray-icon-selected(i); }
                    }
                }
                SettingRow {
                    text: "Text size";
                    Segmented {
                        width: 220px;
                        label: "Text size";
                        options: ["Default", "Large", "Larger"];
                        index <=> root.scale-index;
                        selected(i) => { root.scale-selected(i); }
                    }
                }
                Toggle {
                    text: "Show site icons";
                    description: "Loaded through your server, which learns your sites and may pass them to its icon service";
                    checked <=> root.show-site-icons;
                    toggled(v) => { root.site-icons-toggled(v); }
                }
                Divider { }
                SectionLabel { text: "SECURITY"; }
                SettingRow {
                    text: "Lock after";
                    Select {
                        width: 200px;
                        label: "Lock after";
                        options: root.lock-options;
                        index <=> root.lock-index;
                        selected(i) => { root.lock-selected(i); }
                    }
                }
                Toggle { text: "Lock on sleep or screen lock"; checked <=> root.lock-on-sleep; toggled(v) => { root.lock-on-sleep-toggled(v); } }
                SettingRow {
                    text: "Clear clipboard";
                    Select {
                        width: 200px;
                        label: "Clear clipboard";
                        options: root.clipboard-options;
                        index <=> root.clipboard-index;
                        selected(i) => { root.clipboard-selected(i); }
                    }
                }
                Toggle { text: "Start at login"; checked <=> root.start-at-login; toggled(v) => { root.start-at-login-toggled(v); } }
                Toggle {
                    text: "Update automatically";
                    description: "Checks GitHub daily and installs once the vault is locked";
                    checked <=> root.auto-update;
                    toggled(v) => { root.auto-update-toggled(v); }
                }
                Toggle { text: "Ask to unlock on start"; checked <=> root.ask-unlock-on-start; toggled(v) => { root.ask-unlock-toggled(v); } }
                Toggle {
                    text: "Require master password on app start";
                    description: "Off: Touch ID alone unlocks after a restart";
                    checked <=> root.require-master-password;
                    toggled(v) => { root.require-master-password-toggled(v); }
                }
                SettingRow {
                    text: root.touch-id-enrolled ? "Touch ID is enrolled" : root.touch-id-available ? "Touch ID" : "Touch ID is not available";
                    if root.touch-id-available && !root.touch-id-enrolled: Btn {
                        text: "Enrol";
                        label: "Enrol Touch ID";
                        enabled: root.unlocked;
                        clicked => { root.touch-id-enroll(); }
                    }
                    if root.touch-id-enrolled: Btn {
                        text: "Remove";
                        label: "Remove Touch ID";
                        kind: BtnKind.danger;
                        clicked => { root.touch-id-remove(); }
                    }
                }
                Toggle {
                    text: "Unlock with Touch ID right away";
                    description: root.touch-id-enrolled ? "Skips the lock screen; it opens if Touch ID is cancelled" : "Enrol Touch ID to use this";
                    enabled: root.touch-id-enrolled;
                    checked <=> root.touch-id-right-away;
                    toggled(v) => { root.touch-id-right-away-toggled(v); }
                }
                Divider { }
                SectionLabel { text: "SSH AGENT"; }
                Toggle { text: "SSH agent"; checked <=> root.ssh-agent; toggled(v) => { root.ssh-agent-toggled(v); } }
                SettingRow {
                    text: "Socket";
                    Text {
                        text: root.ssh-socket;
                        font-family: Theme.mono;
                        font-size: Theme.font-meta;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 260px;
                    }
                    CopyBtn {
                        y: 4px;
                        code: 3;
                        label: "Copy socket path";
                        emphasized: true;
                        copy => { return root.copy-socket(); }
                    }
                }
                VerticalLayout {
                    spacing: Theme.s1;
                    Text {
                        text: "To use it, add to ~/.ssh/config:";
                        color: Theme.text-muted;
                        font-size: Theme.font-hint;
                    }
                    Rectangle {
                        background: Theme.surface-raised;
                        border-radius: Theme.radius-control;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding: Theme.s2;
                            spacing: Theme.s2;
                            Text {
                                text: root.ssh-config;
                                font-family: Theme.mono;
                                font-size: Theme.font-meta;
                                color: Theme.text;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                                accessible-role: AccessibleRole.text;
                                accessible-label: "SSH config lines";
                                accessible-value: self.text;
                            }
                            CopyBtn {
                                y: 0px;
                                code: 3;
                                label: "Copy SSH config lines";
                                emphasized: true;
                                copy => { return root.copy-ssh-config(); }
                            }
                        }
                    }
                }
                SettingRow {
                    text: "SSH requires approval";
                    Select {
                        width: 200px;
                        label: "SSH requires approval";
                        options: ["Always", "Remember until lock"];
                        index <=> root.ssh-approval-index;
                        selected(i) => { root.ssh-approval-selected(i); }
                    }
                }
                Toggle { text: "SSH requires Touch ID"; checked <=> root.ssh-touch-id; toggled(v) => { root.ssh-touch-id-toggled(v); } }
                Divider { }
                SectionLabel { text: "CLI ACCESS"; }
                Toggle {
                    text: "Enable CLI access";
                    checked <=> root.cli-access;
                    description: "When enabled, CLI commands can read logins marked “Allow CLI access.” Vaultkeeper prompts you to unlock the vault when needed.";
                    toggled(v) => { root.cli-access-toggled(v); }
                }
                Text {
                    text: "CLI access is read-only. Programs can retain credentials they read. Manage access in Vaultkeeper.";
                    color: Theme.text-muted;
                    font-size: Theme.font-hint;
                    wrap: word-wrap;
                }
                if root.cli-path-setup != "": Text {
                    text: "Copy and paste this command into your terminal (sh, Bash, or Zsh). It adds Vaultkeeper to PATH for that shell. To keep it available in new terminals, add the command to your shell startup file. Run it in the agent’s shell too if it uses a separate one. Then run vaultkeeper --help.";
                    color: Theme.text-muted;
                    font-size: Theme.font-hint;
                    wrap: word-wrap;
                }
                if root.cli-path-setup != "": HorizontalLayout {
                    spacing: Theme.s2;
                    Text {
                        text: root.cli-path-setup;
                        font-family: Theme.mono;
                        font-size: Theme.font-meta;
                        color: Theme.text;
                        horizontal-stretch: 1;
                        wrap: char-wrap;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "CLI setup command";
                        accessible-value: self.text;
                    }
                    CopyBtn {
                        y: 0px;
                        code: 3;
                        label: "Copy CLI setup command";
                        emphasized: true;
                        copy => { return root.copy-cli-path-setup(); }
                    }
                }
                Divider { }
                SectionLabel { text: "BROWSERS"; }
                Toggle {
                    text: "Browser integration";
                    description: root.browser-state;
                    checked <=> root.browser-integration;
                    toggled(v) => { root.browser-integration-toggled(v); }
                }
                if root.chrome-installed: Toggle {
                    text: "Install for Google Chrome";
                    enabled: root.browser-integration;
                    checked <=> root.browser-chrome;
                    toggled(v) => { root.browser-chrome-toggled(v); }
                }
                if root.firefox-installed: Toggle {
                    text: "Install for Firefox";
                    enabled: root.browser-integration;
                    checked <=> root.browser-firefox;
                    toggled(v) => { root.browser-firefox-toggled(v); }
                }
                if root.touch-id-available: Toggle {
                    text: "Require Touch ID to fill";
                    checked <=> root.browser-touch-id;
                    toggled(v) => { root.browser-touch-id-toggled(v); }
                }
                Toggle { text: "Offer to save logins"; checked <=> root.browser-save-prompts; toggled(v) => { root.browser-save-prompts-toggled(v); } }
                Toggle { text: "Copy TOTP code after filling"; checked <=> root.browser-copy-totp; toggled(v) => { root.browser-copy-totp-toggled(v); } }
                Toggle {
                    text: "Fill at once when only one login matches";
                    description: "Skips the picker when a single saved login matches the site. Touch ID still applies.";
                    checked <=> root.browser-fill-single;
                    toggled(v) => { root.browser-fill-single-toggled(v); }
                }
                Toggle {
                    text: "Save and use passkeys";
                    description: "Sites create and sign in with passkeys kept in the vault, after Touch ID. Off: the browser's own passkeys answer.";
                    checked <=> root.browser-passkeys;
                    toggled(v) => { root.browser-passkeys-toggled(v); }
                }
                SettingRow {
                    text: "Match sites by";
                    Segmented {
                        width: 220px;
                        label: "Match sites by";
                        options: ["Domain", "Exact host"];
                        index <=> root.browser-match-index;
                        selected(i) => { root.browser-match-selected(i); }
                    }
                }
                SectionLabel { text: "PAIRED BROWSERS"; }
                if root.paired-browsers.length == 0: Text {
                    text: "No browser is connected yet";
                    color: Theme.text-muted;
                    font-size: Theme.font-hint;
                }
                for paired in root.paired-browsers: SettingRow {
                    text: paired.name;
                    Text {
                        text: paired.fingerprint;
                        font-family: Theme.mono;
                        font-size: Theme.font-meta;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        accessible-role: AccessibleRole.text;
                        accessible-label: paired.name + " fingerprint";
                        accessible-value: self.text;
                    }
                    Btn {
                        text: "Remove";
                        label: "Remove " + paired.name;
                        kind: BtnKind.danger;
                        clicked => { root.paired-browser-removed(paired.key); }
                    }
                }
                Divider { }
                SectionLabel { text: "SHORTCUTS"; }
                SettingRow {
                    text: "Quick Panel hotkey";
                    quick-recorder := ShortcutRecorder {
                        width: 200px;
                        label: "Quick Panel hotkey";
                        shown: root.hotkey-shown;
                        pressed(text, control, meta, alt, shift) => {
                            return root.hotkey-pressed(text, control, meta, alt, shift);
                        }
                        entered(accelerator) => { root.hotkey-accepted(accelerator); }
                    }
                }
                SettingRow {
                    text: "Generator hotkey";
                    generator-recorder := ShortcutRecorder {
                        width: 200px;
                        label: "Generator hotkey";
                        shown: root.generator-hotkey-shown;
                        clearable: true;
                        pressed(text, control, meta, alt, shift) => {
                            return root.generator-hotkey-pressed(text, control, meta, alt, shift);
                        }
                        entered(accelerator) => { root.generator-hotkey-accepted(accelerator); }
                        cleared => { root.generator-hotkey-accepted(""); }
                    }
                }
                if root.error-text != "": Text {
                    text: root.error-text;
                    color: Theme.danger;
                    font-size: Theme.font-hint;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Settings error";
                    accessible-value: self.text;
                }
                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}

export component GeneratorWindow inherits Window {
    title: "Vaultkeeper — generator";
    icon: @image-url("icons/tray-dark.svg");
    preferred-width: 420px;
    preferred-height: 28px + view.content-height;
    min-width: 360px;
    min-height: 240px;
    background: Theme.surface;
    default-font-size: Theme.font-body;
    callback close-generator();
    forward-focus: generator-keys;
    generator-keys := FocusScope {
        capture-key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-generator();
                return accept;
            }
            if event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta && (event.text == "c" || event.text == "C") {
                GeneratorState.copy-result();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            // The title in the transparent title bar beside the traffic lights, as in Settings.
            Rectangle {
                height: 28px;
                WindowMoveArea { }
                Text {
                    text: "Generator";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            view := GeneratorView {
                show-title: false;
            }
        }
    }
}

// Shortcut labels per platform: ⌘ and ⇧ on macOS, Ctrl and Shift on Windows and Linux (Slint
// reports the Ctrl key as `control` there, so the in-window shortcuts use the key the hint names).
export global Keys {
    out property <bool> ctrl-keys: Platform.os != OperatingSystemType.macos;
    out property <string> cmd: root.ctrl-keys ? "Ctrl+" : "⌘";
    out property <string> shift: root.ctrl-keys ? "Shift+" : "⇧";
    out property <string> cmd-shift: root.cmd + root.shift;
    out property <string> enter: root.ctrl-keys ? "Enter" : "↩";
    out property <string> cmd-cap: root.ctrl-keys ? "Ctrl" : "⌘";
    out property <string> shift-cap: root.ctrl-keys ? "Shift" : "⇧";
    out property <string> cmd-shift-cap: root.ctrl-keys ? "Ctrl+Shift" : "⌘⇧";
}

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Btn, BtnKind, EmptyState, Field, Icon, KindChip, PromptHeader } from "kit.slint";

// `icon` is the site's icon once it has loaded; empty (width 0) until then.
export struct BrowserPickerRow { name: string, username: string, other-site: bool, icon: image }

export component BrowserPicker inherits Window {
    title: "Fill login";
    no-frame: true;
    always-on-top: true;
    width: 480px;
    height: 360px;
    out property <length> panel-width: self.width;
    out property <length> panel-height: self.height;
    background: Theme.surface;
    default-font-size: Theme.font-body;
    in property <string> browser;
    in property <string> host;
    in property <bool> insecure;
    in property <bool> touch-id;
    in property <[BrowserPickerRow]> rows;
    in-out property <string> query;
    in-out property <int> selected: 0;
    in-out property <bool> confirm-other: false;
    in property <string> confirm-text;
    in-out property <bool> reprompt: false;
    in-out property <string> password;
    in property <string> password-error;
    in-out property <int> seconds-left: 60;
    property <length> list-height: 155px;
    property <length> scroll-y;
    out property <int> first-visible: max(0, floor(-root.scroll-y / Theme.row-height));
    out property <int> visible-count: ceil(root.list-height / Theme.row-height) + 1;
    callback search-edited(string);
    callback pick(int);
    callback confirm();
    callback cancel-confirm();
    callback submit-password(string);
    callback dismiss();
    callback visible-range-changed();

    Timer { interval: 1s; running: root.seconds-left > 0; triggered => { root.seconds-left -= 1; } }
    Rectangle {
        border-width: 1px; border-color: Theme.border; border-radius: Theme.radius-popup; clip: true;
        FocusScope {
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.dismiss(); return accept; }
                if event.text == Key.Return && root.confirm-other { root.cancel-confirm(); return accept; }
                if !root.confirm-other && !root.reprompt && event.text == Key.Return { root.pick(root.selected); return accept; }
                if !root.confirm-other && !root.reprompt && event.text == Key.DownArrow { root.selected = min(root.selected + 1, max(0, root.rows.length - 1)); return accept; }
                if !root.confirm-other && !root.reprompt && event.text == Key.UpArrow { root.selected = max(0, root.selected - 1); return accept; }
                return reject;
            }
            VerticalLayout {
                padding: 18px; spacing: 8px;
                PromptHeader { glyph: @image-url("icons/shield.svg"); title: "Fill login"; }
                Text { text: root.browser + " · " + root.host; color: Theme.text-muted; }
                if root.insecure: HorizontalLayout {
                    spacing: 6px;
                    Icon { width: 14px; height: 14px; y: 2px; source: @image-url("icons/warning.svg"); tint: Theme.warn-text; }
                    Text { text: "Not encrypted (http)"; color: Theme.warn-text; }
                }
                if root.confirm-other: FocusScope {
                    init => { self.focus(); }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: root.confirm-text; color: Theme.text; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: end; spacing: Theme.gap;
                            Btn { text: "Cancel"; label: "Cancel"; clicked => { root.cancel-confirm(); } }
                            Btn { text: "Fill anyway"; label: "Fill anyway"; kind: BtnKind.primary; clicked => { root.confirm(); } }
                        }
                    }
                }
                if root.reprompt: VerticalLayout {
                    spacing: 8px;
                    Field {
                        init => { self.focus-input(); }
                        placeholder: "Master password"; label: "Master password"; password: true;
                        text <=> root.password;
                        accepted(text) => { root.submit-password(text); }
                    }
                    Text { text: root.password-error; color: Theme.warn-text; }
                    Btn { text: "Confirm"; label: "Confirm password"; kind: BtnKind.primary; clicked => { root.submit-password(root.password); } }
                }
                if !root.confirm-other && !root.reprompt: VerticalLayout {
                    spacing: 8px;
                    Field { init => { self.focus-input(); } placeholder: "Search vault"; label: "Search vault"; text <=> root.query; edited(text) => { root.search-edited(text); } }
                    if root.rows.length == 0: EmptyState { title: root.query == "" ? "No login saved for " + root.host : "No matches"; body: root.query == "" ? "Type to search the vault" : ""; }
                    if root.rows.length > 0: ScrollView {
                        height: root.list-height;
                        content-width: self.visible-width;
                        changed content-y => {
                            root.scroll-y = self.content-y;
                            root.visible-range-changed();
                        }
                        VerticalLayout {
                            alignment: start;
                            for row[index] in root.rows: Rectangle {
                                height: Theme.row-height;
                                background: index == root.selected ? Theme.selection : transparent;
                                TouchArea { clicked => { root.pick(index); } }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                                    // One slot for the chip and the icon, so an icon arriving never moves the row.
                                    slot := Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: 22px * Theme.scale;
                                        height: self.width;
                                        property <bool> icon-shown: Theme.site-icons && row.icon.width > 0;
                                        if !slot.icon-shown: KindChip { kind: 0; size: slot.width; }
                                        if slot.icon-shown: Image {
                                            width: slot.width;
                                            height: slot.height;
                                            source: row.icon;
                                            image-fit: contain;
                                            accessible-role: none;
                                        }
                                    }
                                    Text { text: row.name; color: Theme.text; vertical-alignment: center; }
                                    Text { text: row.username; color: Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
                                    if row.other-site: Text { text: "other site"; color: Theme.text-muted; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Text { text: root.touch-id ? "Return · then Touch ID" : "Return · fill"; color: Theme.text-muted; font-size: Theme.font-meta; }
                Rectangle {
                    height: 3px; border-radius: 1.5px; background: Theme.surface-raised;
                    Rectangle { width: parent.width * max(0, root.seconds-left) / 60; height: 100%; border-radius: 1.5px; background: root.seconds-left < 6 ? Theme.warn : Theme.accent; animate width { duration: 1s; easing: linear; } }
                }
            }
        }
    }
}
